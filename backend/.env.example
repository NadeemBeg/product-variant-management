# Copy to .env and adjust. All values have safe defaults for local dev.
NODE_ENV=development
PORT=4000

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/pvms

# Where uploaded images are written and served from (swap for S3/OCI in prod).
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated allowed origins, or * for any (dev only).
CORS_ORIGIN=*
